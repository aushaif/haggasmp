# ==========================================
# REPORT SYSTEM
# ==========================================

command /report <player> <text>:
    permission: none
    trigger:

        if arg 1 is not online:
            send "&cThat player is not online!"
            stop

        set {_reason} to arg 2

        send "&aThank you! Your report against &e%arg 1% &afor &c%{_reason}% &ahas been submitted."

        loop all players:
            if loop-player has permission "report.see":
                send "&c[REPORT] &e%player% &7reported &c%arg 1% &7for: &f%{_reason}%" to loop-player

        log "[REPORT] %player% reported %arg 1% for: %{_reason}%"

