# ==================================================
#  Complete SMP Server System - FIXED VERSION
#  Server Commands + TPA System - Pure Skript Compatible
#  No addons required - Works with basic Skript
# ==================================================

# TPA Options
options:
    tpa-time: 60 seconds

# Define staff members (add/remove as needed)
on load:
    set {staff::admin::*} to "InfinityNoob"
    set {staff::coop::*} to ".Haras124"

# ---------- AFK Command (Updated to preserve nametags) ----------
command /afk:
    trigger:
        if {afk.%player%} is not set:
            set {afk.%player%} to true
            # Store original display name
            set {original.displayname.%player%} to player's display name
            set player's display name to "&7[AFK] %player's display name%"
            broadcast "&7[AFK] &e%player% &7is now AFK."
        else:
            delete {afk.%player%}
            # Restore original display name or set based on rank
            if {original.displayname.%player%} is set:
                set player's display name to {original.displayname.%player%}
                delete {original.displayname.%player%}
            else:
                # Fallback: reset based on rank
                if isAdmin(player) is true:
                    set player's display name to "&c&l⚡ &c[Admin] &6%player%"
                else if isCoop(player) is true:
                    set player's display name to "&9&l⚙ &9[Co-Operator] &b%player%"
                else:
                    set player's display name to "&f%player%"
            broadcast "&a%player% &7is no longer AFK."

# ---------- Report Command ----------
command /report <player> <text>:
    permission: none
    trigger:
        if arg 1 is not online:
            send "&cThat player is not online!"
            stop
        set {_reason} to arg 2
        send "&aThank you! Your report against &e%arg 1% &afor &c%{_reason}% &ahas been submitted."
        loop all players:
            if loop-player has permission "report.see":
                send "&c[REPORT] &e%player% &7reported &c%arg 1% &7for: &f%{_reason}%" to loop-player
        # Fixed logging - removed file path that might cause issues
        log "[REPORT] %player% reported %arg 1% for: %{_reason}%"

# ---------- Discord Command ----------
command /discord:
    trigger:
        send "&bJoin our community Discord:"
        send "&9&nhttps://discord.gg/dvRPUwD5Cw"

# ---------- Rules Command ----------
command /rules:
    trigger:
        send "&6===== SMP Rules ====="
        send "&a1. Respect all players."
        send "&a2. No griefing — destroying bases, stealing, or ruining the SMP is strictly forbidden."
        send "   &7(If both players agree, they can do anything on each other's property.)"
        send "&a3. No hacking, cheating, or exploiting bugs."
        send "&a4. Keep chat clean — no spamming or inappropriate content."
        send "&a5. Follow staff instructions at all times."
        send "&6====================="

# ---------- Server Commands List ----------
command /cmd:
    aliases: /commands, /help
    trigger:
        send "&6========== &eServer Commands &6=========="
        send "&a/afk &7- Toggle AFK status"
        send "&a/report <player> <reason> &7- Report a player"
        send "&a/discord &7- Get Discord invite link"
        send "&a/rules &7- View server rules"
        send "&a/tpa <player> &7- Send teleport request"
        send "&a/tpaaccept <player> &7- Accept teleport request"
        send "&a/tpadeny <player> &7- Deny teleport request"
        send "&a/tpastatus &7- Check pending requests"
        send "&a/cmd &7- View this command list"
        send "&6====================================="

