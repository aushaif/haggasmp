# ---------- Welcome Message ----------
on first join:
    send "&eWelcome &6%player%&e to the SMP for the first time!" to player
    broadcast "&eEveryone welcome &6%player%&e to our SMP!"
    wait 2 seconds
    send "&b&l➤ &eType &a&l/cmd &eto view all server commands!" to player

# ---------- Join Reminder ----------
on join:
    wait 3 seconds
    send "&7&l[&b&lTIP&7&l] &fType &a&l/cmd &fto view all available server commands!" to player

# ---------- Function to check if player is staff ----------
function isAdmin(p: player) :: boolean:
    loop {staff::admin::*}:
        if "%{_p}%" is loop-value:
            return true
    return false

function isCoop(p: player) :: boolean:
    loop {staff::coop::*}:
        if "%{_p}%" is loop-value:
            return true
    return false

# ---------- OP Command Logging (Fixed) ----------
on command:
    if player is op:
        if isAdmin(player) is false:
            loop all players:
                if isAdmin(loop-player) is true:
                    send "&e[OP-CMD] &6%player% &7used: &f/%command% &8[%now%]" to loop-player

# ---------- Enhanced Chat System ----------
on chat:
    cancel event
    set {_prefix} to ""
    set {_nameColor} to "&f"
    
    # Check if player is Admin
    if isAdmin(player) is true:
        set {_prefix} to "&c&l⚡ &c[Admin] "
        set {_nameColor} to "&6"
    
    # Check if player is Co-Operator
    else if isCoop(player) is true:
        set {_prefix} to "&9&l⚙ &9[Co-Operator] "
        set {_nameColor} to "&b"
    
    # Broadcast the formatted message
    broadcast "%{_prefix}%%{_nameColor}%%player%&f: %message%"

# ---------- Tab List Name Updates + Nametag Display ----------
on join:
    wait 1 tick
    if isAdmin(player) is true:
        set player's tab list name to "&c&l⚡ &6%player%"
        set player's display name to "&c&l⚡ &c[Admin] &6%player%"
    else if isCoop(player) is true:
        set player's tab list name to "&9&l⚙ &b%player%"
        set player's display name to "&9&l⚙ &9[Co-Operator] &b%player%"
    else:
        set player's tab list name to "&f%player%"
        set player's display name to "&f%player%"

# ---------- Cleanup when players leave ----------
on quit:
    # Clean up AFK status
    delete {afk.%player%}
    delete {original.displayname.%player%}
    
    # Clean up TPA requests TO this player
    delete {tpa.request.%player%}
    
    # Clean up TPA requests FROM this player
    loop {tpa.request::*}:
        if loop-value is player:
            delete {tpa.request::%loop-index%}
            if loop-index parsed as player is online:
                send "&7The teleport request from &c%player% &7was cancelled (player left)." to loop-index parsed as player
