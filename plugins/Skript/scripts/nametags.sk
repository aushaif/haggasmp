# ==========================================
# TAB LIST + NAMETAGS
# ==========================================

on join:
    wait 1 tick

    # Admin
    if player is op:
        set player's tab list name to "&c&l⚡ &6%player%"
        set player's display name to "&c&l⚡ &c[Admin] &6%player%"

    # Co-Operator
    else if {coop.%player%} is set:
        set player's tab list name to "&9&l⚙ &b%player%"
        set player's display name to "&9&l⚙ &9[Co-Operator] &b%player%"

    # Normal player
    else:
        set player's tab list name to "&f%player%"
        set player's display name to "&f%player%"


# ==========================================
# CUSTOM CHAT
# ==========================================

on chat:
    cancel event

    set {_prefix} to ""
    set {_nameColor} to "&f"

    # Admin
    if player is op:
        set {_prefix} to "&c&l⚡ &c[Admin] "
        set {_nameColor} to "&6"

    # Co-Operator
    else if {coop.%player%} is set:
        set {_prefix} to "&9&l⚙ &9[Co-Operator] "
        set {_nameColor} to "&b"

    broadcast "%{_prefix}%%{_nameColor}%%player%&f: %message%"
