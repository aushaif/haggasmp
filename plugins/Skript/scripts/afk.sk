# ==========================================
# AFK SYSTEM
# ==========================================

command /afk:
    trigger:

        # ==========================================
        # GO AFK
        # ==========================================

        if {afk.%player%} is not set:

            set {afk.%player%} to true

            # Save original display name
            set {original.displayname.%player%} to player's display name

            # Add AFK prefix
            set player's display name to "&7[AFK] %player's display name%"

            broadcast "&7[AFK] &e%player% &7is now AFK."

            stop


        # ==========================================
        # RETURN FROM AFK
        # ==========================================

        delete {afk.%player%}

        # Restore original display name
        if {original.displayname.%player%} is set:

            set player's display name to {original.displayname.%player%}

            delete {original.displayname.%player%}

        broadcast "&a%player% &7is no longer AFK."
